# Se lee con: node --env-file=.env backend/server.cjs
PORT=3000
HOST=127.0.0.1
# Requerida solo al crear una base nueva. Usa una contraseña de al menos 12 caracteres.
SEED_PASSWORD=ReemplazaEstaClave-2026
# Activa únicamente al servir por HTTPS.
COOKIE_SECURE=false
# DB_PATH=/ruta/privada/changeflow.sqlite

# ---------- Integración con GitHub (opcional; ver docs/github.md) ----------
# Repositorio de BusesUTA en formato propietario/repositorio.
# GITHUB_REPO=tu-organizacion/busesuta
# Token de acceso fino (fine-grained) con permisos sobre ese repositorio:
#   Issues: lectura y escritura · Contents: lectura y escritura · Pull requests: lectura y escritura · Metadata: lectura
# Sin token solo se verifican referencias de repositorios públicos y no se crean issues.
# GITHUB_TOKEN=
# Dirección pública de esta aplicación, para enlazar el expediente desde la issue.
# APP_URL=http://127.0.0.1:3000
